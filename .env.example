# ─────────────────────────────────────────────────────────────────────────────
# samrosa — Environment Configuration Template
# Copy this file to .env and populate all values before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL — pgBouncer-compatible connection string or individual params
DATABASE_URL=postgresql://samrosa_user:strongpassword@localhost:5432/samrosa_db

# Optional individual connection fields (used as fallback if DATABASE_URL is absent)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=samrosa_user
# PGPASSWORD=strongpassword
# PGDATABASE=samrosa_db

# Connection Pool Tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
